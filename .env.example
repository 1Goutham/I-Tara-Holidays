# Public site URL (used for canonical / Open Graph / sitemap)
NEXT_PUBLIC_SITE_URL=https://www.itaraholidays.com

# Where enquiry & newsletter submissions are forwarded (server-side).
# Any endpoint that accepts JSON POSTs works: Formspree, Getform, Zapier/Make webhook, your CRM, etc.
# If unset, the forms fall back to opening the visitor's email app.
ENQUIRY_WEBHOOK_URL=
